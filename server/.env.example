PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRE=7d

MONGODB_URI=mongodb://localhost:27017/smart_agro

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Your Gmail address (the account that sends OTPs)
EMAIL_USER=your.name@gmail.com
# Gmail App Password (not your normal password):
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=Smart Agro Community <your.name@gmail.com>

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# Gemini (primary) — leaf detect + farmer chatbot
# Get keys: https://aistudio.google.com/apikey
# Keys rotate automatically when one hits free-tier quota
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
# Optional extra keys, comma-separated
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash

# Primary AI for leaf detect + farmer chat.
# local = FastAPI on this PC (works in Myanmar without VPN). Then Cursor/Gemini if the network allows.
AI_PROVIDER=local

# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_DETECT_TIMEOUT_MS=12000

WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=900
# Open-Meteo is often blocked without VPN. Keep short; the server then uses a seasonal estimate.
WEATHER_TIMEOUT_MS=8000

FILE_STORAGE_TYPE=gridfs

RATE_LIMIT_MAX_PER_MINUTE=100
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Dev-only fallback when EMAIL_USER / EMAIL_PASS are empty
OTP_DEV_LOG=true
# Fixed OTP used ONLY if Gmail SMTP is not configured (ignored when EMAIL_USER+EMAIL_PASS are set)
DEV_OTP=112233

CLIENT_ORIGIN=http://localhost:5173
